{
  "name": "mcode-space",
  "version": "0.7.0",
  "description": "Seu código, seus terminais. Um espaço MCode.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "npm run build && electron . --smoke-test",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "lucide": "1.65.0",
    "marked": "18.1.2",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "br.com.mcode.space",
    "productName": "MCode Space",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/lucide/**",
      "!node_modules/marked/**",
      "!node_modules/dompurify/**",
      "!node_modules/@xterm/**",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/third_party/**",
      "!node_modules/node-pty/build/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "MCode-Space-${version}.exe"
    }
  }
}
